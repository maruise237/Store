# Générer avec: openssl rand -hex 32  (minimum 32 caractères)
SESSION_SECRET=replace_with_32_plus_char_random_string

# Chemin du fichier SQLite dans le conteneur (correspond au volume Coolify)
DATABASE_URL=./data/store.db

# Identifiants admin créés au premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production

NODE_ENV=production
